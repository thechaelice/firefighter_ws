<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>firefighter_perception</name>
  <version>0.1.0</version>
  <description>
    Thermal flame perception: reads the Melexis MLX90641 IR array (via the
    vendored C reader in scripts/thermal/), publishes a thermal image and
    flame events with bearing and LiDAR-derived range.
  </description>
  <maintainer email="thechalice22@gmail.com">thechaelice</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>firefighter_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
