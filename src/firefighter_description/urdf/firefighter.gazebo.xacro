<?xml version="1.0"?>
<!--
  Simulation model: the LinkForge-exported description plus the Gazebo (Harmonic)
  drive, joint-state and LiDAR plugins. Hand-written - firefighter.urdf.xacro is
  regenerated by model/export_firefighter_description.py, so Gazebo tags live here.

  Topics mirror the real robot: /cmd_vel in, /wheel_odom and /scan out.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="firefighter">
  <xacro:include filename="$(find firefighter_description)/urdf/firefighter.urdf.xacro" />

  <!-- MUST MATCH wheel_radius_m / track_width_m in firefighter_bridge/config/bridge.yaml -->
  <xacro:property name="wheel_radius" value="0.0325" />
  <xacro:property name="track_width" value="0.20" />

  <gazebo>
    <!-- Stands in for the mobility ESP32: odometry only, no odom -> base_link TF
         (the EKF owns that transform, exactly as on the real robot). -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>wheel_odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- RPLIDAR A1: 360 deg, 0.15 - 12 m. -->
  <gazebo reference="laser">
    <sensor name="rplidar" type="gpu_lidar">
      <gz_frame_id>laser</gz_frame_id>
      <topic>scan</topic>
      <update_rate>8</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
</robot>
