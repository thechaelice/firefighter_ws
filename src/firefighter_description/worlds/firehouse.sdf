<?xml version="1.0"?>
<!--
  Indoor test world for the firefighter robot (Gazebo Harmonic).

  A 6 m x 4 m building split into three rooms by doorways 0.8 m wide. The robot
  spawns at the origin facing +X, in the west room; the fire is in the east room.

        y=+2  +=============+==========+==  ==+
              |  crate      |          |      |
              |             |   crate         |  <- door (east room)
              |   robot ->     door    | FIRE |
              |             |=====     |      |
              |  barrel     |          | desk |
        y=-2  +=============+==========+======+
             x=-1          1.5        3.4     5
-->
<sdf version="1.9">
  <world name="firehouse">
    <!-- 4 ms steps. With 1 ms steps and the full Nav2 stack running, a 12-core PC
         could only simulate at 0.3x real time, which slows every sensor to match. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.48 1</ambient>
      <background>0.10 0.11 0.13 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="ceiling" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.93</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.42 0.42 0.44 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls: 0.1 m thick, 0.5 m tall (the LiDAR scans at 0.22 m). -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- outer shell -->
        <collision name="south_c"><pose>2 -2.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="south_v"><pose>2 -2.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry><material><ambient>0.80 0.78 0.72 1</ambient><diffuse>0.80 0.78 0.72 1</diffuse></material></visual>
        <collision name="north_c"><pose>2 2.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="north_v"><pose>2 2.05 0.25 0 0 0</pose><geometry><box><size>6.2 0.1 0.5</size></box></geometry><material><ambient>0.80 0.78 0.72 1</ambient><diffuse>0.80 0.78 0.72 1</diffuse></material></visual>
        <collision name="west_c"><pose>-1.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="west_v"><pose>-1.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 4.0 0.5</size></box></geometry><material><ambient>0.80 0.78 0.72 1</ambient><diffuse>0.80 0.78 0.72 1</diffuse></material></visual>
        <collision name="east_c"><pose>5.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="east_v"><pose>5.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 4.0 0.5</size></box></geometry><material><ambient>0.80 0.78 0.72 1</ambient><diffuse>0.80 0.78 0.72 1</diffuse></material></visual>

        <!-- west | middle divider at x = 1.5, door at y = -0.3 .. 0.5 -->
        <collision name="div_a_south_c"><pose>1.5 -1.15 0.25 0 0 0</pose><geometry><box><size>0.1 1.7 0.5</size></box></geometry></collision>
        <visual name="div_a_south_v"><pose>1.5 -1.15 0.25 0 0 0</pose><geometry><box><size>0.1 1.7 0.5</size></box></geometry><material><ambient>0.66 0.70 0.74 1</ambient><diffuse>0.66 0.70 0.74 1</diffuse></material></visual>
        <collision name="div_a_north_c"><pose>1.5 1.25 0.25 0 0 0</pose><geometry><box><size>0.1 1.5 0.5</size></box></geometry></collision>
        <visual name="div_a_north_v"><pose>1.5 1.25 0.25 0 0 0</pose><geometry><box><size>0.1 1.5 0.5</size></box></geometry><material><ambient>0.66 0.70 0.74 1</ambient><diffuse>0.66 0.70 0.74 1</diffuse></material></visual>

        <!-- middle | east divider at x = 3.4, door at y = 0.9 .. 1.7 -->
        <collision name="div_b_south_c"><pose>3.4 -0.55 0.25 0 0 0</pose><geometry><box><size>0.1 2.9 0.5</size></box></geometry></collision>
        <visual name="div_b_south_v"><pose>3.4 -0.55 0.25 0 0 0</pose><geometry><box><size>0.1 2.9 0.5</size></box></geometry><material><ambient>0.66 0.70 0.74 1</ambient><diffuse>0.66 0.70 0.74 1</diffuse></material></visual>
        <collision name="div_b_north_c"><pose>3.4 1.85 0.25 0 0 0</pose><geometry><box><size>0.1 0.3 0.5</size></box></geometry></collision>
        <visual name="div_b_north_v"><pose>3.4 1.85 0.25 0 0 0</pose><geometry><box><size>0.1 0.3 0.5</size></box></geometry><material><ambient>0.66 0.70 0.74 1</ambient><diffuse>0.66 0.70 0.74 1</diffuse></material></visual>

        <!-- partition inside the middle room -->
        <collision name="partition_c"><pose>2.05 -0.6 0.25 0 0 0</pose><geometry><box><size>1.1 0.1 0.5</size></box></geometry></collision>
        <visual name="partition_v"><pose>2.05 -0.6 0.25 0 0 0</pose><geometry><box><size>1.1 0.1 0.5</size></box></geometry><material><ambient>0.66 0.70 0.74 1</ambient><diffuse>0.66 0.70 0.74 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles -->
    <model name="crate_west">
      <static>true</static>
      <pose>-0.4 1.3 0.15 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.3 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.3 0.3</size></box></geometry>
          <material><ambient>0.55 0.38 0.20 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="barrel">
      <static>true</static>
      <pose>0.4 -1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.10 0.25 0.55 1</ambient><diffuse>0.10 0.25 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_middle">
      <static>true</static>
      <pose>2.6 1.2 0.2 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.55 0.38 0.20 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="desk">
      <static>true</static>
      <pose>4.3 -1.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.4</size></box></geometry>
          <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.30 0.32 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The fire: glows, lights the room, and is hot to a Gazebo thermal camera. -->
    <model name="fire">
      <static>true</static>
      <pose>4.4 1.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.35 0.0 1</ambient>
            <diffuse>1.0 0.35 0.0 1</diffuse>
            <emissive>1.0 0.30 0.0 1</emissive>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>600</temperature>
          </plugin>
        </visual>
      </link>
    </model>
    <light name="fire_glow" type="point">
      <pose>4.4 1.0 0.5 0 0 0</pose>
      <diffuse>1.0 0.45 0.1 1</diffuse>
      <specular>0.3 0.1 0.0 1</specular>
      <attenuation>
        <range>4</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.1</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
  </world>
</sdf>
